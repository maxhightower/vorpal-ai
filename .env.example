# Optional LLM provider configuration. The MVP runs without these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional web retrieval (Tavily). Required for TavilyWebRetriever to return results.
TAVILY_API_KEY=

# Storage
FACTUALITY_HARNESS_DB_URL=sqlite:///./factuality_harness.db
FACTUALITY_HARNESS_AUDIT_DIR=./audit_logs

# Behavior
FACTUALITY_HARNESS_LOG_LEVEL=INFO
